# ---------- ÉTAGE 1 : BUILD ----------
# Image lourde avec Node, uniquement pour compiler
FROM node:20-alpine AS builder

WORKDIR /app

# Les dépendances d'abord (cache)
COPY package.json package-lock.json ./
RUN npm ci

# Puis le code
COPY . .

# Compile React → fichiers statiques dans /app/dist
RUN npm run build


# ---------- ÉTAGE 2 : PRODUCTION ----------
# Image légère, juste nginx
FROM nginx:alpine

# On récupère UNIQUEMENT le résultat compilé de l'étage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Notre configuration nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]